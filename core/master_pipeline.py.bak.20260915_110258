def _status(phase, value):
    SYSTEM_STATE["component_status"][phase] = value


def _run_phase(name, function):
    if SYSTEM_STATE["stop_requested"]:
        _status(name, "STOPPED")
        return False

    try:
        print(f"[{name}] START")
        result = function()

        if result is False:
            _status(name, "FAIL")
            SYSTEM_STATE["healthy"] = False
            return False

        _status(name, "OK")
        print(f"[{name}] OK")
        return True

    except Exception as exc:
        _status(name, f"FAIL: {exc}")
        SYSTEM_STATE["last_error"] = str(exc)
        SYSTEM_STATE["healthy"] = False

        print(f"[{name}] ERROR: {exc}")
        traceback.print_exc()

        return False


