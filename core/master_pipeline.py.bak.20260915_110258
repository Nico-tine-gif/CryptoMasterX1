# ============================================================
# HEALTH CONTROLLER
# ============================================================

class HealthController(threading.Thread):
    """
    Runtime watchdog.

    Owns:
    - system health
    - component health
    - heartbeat
    - error detection
    - runtime stability
    - recovery signalling
    """

    def __init__(self, interval=5):
        super().__init__(daemon=True)
        self.running = True
        self.interval = interval

    def stop(self):
        self.running = False

    def run(self):
        while self.running:
            try:
                SYSTEM_STATE["heartbeat"] = datetime.utcnow().isoformat()

                if not SYSTEM_STATE["pipeline_running"]:
                    time.sleep(self.interval)
                    continue

                failed = [
                    name
                    for name, status in SYSTEM_STATE[
                        "component_status"
                    ].items()
                    if str(status).startswith("FAIL")
                ]

                if failed:
                    SYSTEM_STATE["healthy"] = False
                    SYSTEM_STATE["last_error"] = (
                        "Failed components: " + ",".join(failed)
                    )

                time.sleep(self.interval)

            except Exception as exc:
                SYSTEM_STATE["healthy"] = False
                SYSTEM_STATE["last_error"] = str(exc)
                time.sleep(self.interval)


# ============================================================
# MASTER PIPELINE
# ============================================================

class MasterPipeline:

    def __init__(self):
        self.health = HealthController()
        self.phases = [
            ("P1", P1_machine_core),
            ("P2", P2_account_binding),
            ("P3", P3_binance_verification),
            ("P4", P4_market_discovery),
            ("P5", P5_market_intelligence),
            ("P6", P6_trade_quality),
            ("P7", P7_entry_intelligence),
            ("P8", P8_execution_preparation),
            ("P9", P9_decision_gate),
            ("P10", P10_trade_execution_monitoring),
            ("P11", P11_system_verification),
        ]

    def stop(self):
        SYSTEM_STATE["stop_requested"] = True
        SYSTEM_STATE["pipeline_running"] = False
        self.health.stop()

    def run(self):
        SYSTEM_STATE["pipeline_running"] = True
        SYSTEM_STATE["stop_requested"] = False
        SYSTEM_STATE["healthy"] = True
        SYSTEM_STATE["last_error"] = None
        SYSTEM_STATE["started_at"] = datetime.utcnow().isoformat()

        if not self.health.is_alive():
            self.health.start()

        print("")
        print("============================================================")
        print(" CryptoMasterX1 MASTER PIPELINE")
        print(" 11 PHASES + V8 + HEALTH CONTROLLER")
        print("============================================================")
        print("")

        try:
            for name, function in self.phases:

                if SYSTEM_STATE["stop_requested"]:
                    print("[PIPELINE] STOP REQUESTED")
                    break

                if not _run_phase(name, function):
                    print(
                        f"[PIPELINE] STOPPED after {name}"
                    )
                    break

            else:
                print("")
                print("[PIPELINE] ALL PHASES COMPLETE")

        except Exception as exc:
            SYSTEM_STATE["healthy"] = False
            SYSTEM_STATE["last_error"] = str(exc)
            traceback.print_exc()

        finally:
            SYSTEM_STATE["pipeline_running"] = False
            SYSTEM_STATE["finished_at"] = datetime.utcnow().isoformat()

        print("")
        print("============================================================")
        print(" PIPELINE STATUS")
        print("============================================================")
        print("Healthy:", SYSTEM_STATE["healthy"])
        print("Components:", SYSTEM_STATE["component_status"])
        print("============================================================")

        return SYSTEM_STATE["healthy"]


def run_master_pipeline():
    pipeline = MasterPipeline()
    return pipeline.run()


if __name__ == "__main__":
    run_master_pipeline()
